{
  "name": "weather_site",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npm run test:unit && npm run test:nuxt",
    "test:unit": "TZ=Europe/Lisbon vitest run",
    "test:nuxt": "TZ=Europe/Lisbon vitest run --config vitest.nuxt.config.ts"
  },
  "dependencies": {
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/seo": "^5.3.0",
    "@rafaelfrancisco-dev/ipma-weather-js": "^0.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nuxt": "^10.63.0",
    "@vercel/analytics": "^2.1.0-canary",
    "@vercel/speed-insights": "^2.0.1-canary",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.3.0",
    "chart.js": "^4.5.1",
    "ioredis": "^5.4.1",
    "mapbox-gl": "^3",
    "nuxt": "^4.4.8",
    "satori": "^0.26.0",
    "vite": "^7.3.5",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true,
    "@sentry/cli@2.58.6": true
  },
  "overrides": {
    "@vercel/speed-insights": {
      "vue-router": "$vue-router"
    },
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "vitest": "^4.1.9"
  }
}
